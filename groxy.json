                        "interval": 120
                    }
                },
                {
                    "protocol": "http",
                    "host": "localhost",
                    "port": 8002,
                    "health": {
                        "path": "/health",
                        "interval": 120
                    }
                }
            ]
        },
        {
            "host": "ssd",
            "backends": [
                {
                    "protocol": "http",

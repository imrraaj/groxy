{
    "proxy": {
        "port": 80,
        "read_timeout": 30,
        "write_timeout": 30
    },
    "routes": [
        {
            "host": "a.local",
            "backends": [
                {
                    "protocol": "http",
                    "host": "127.0.0.1",
                    "port": 8001,
                    "health": {
                        "path": "/health",
                        "interval": 10
                    }
                }
            ]
        },
        {
            "host": "b.local",
            "backends": [
                {
                    "protocol": "http",
                    "host": "127.0.0.1",
                    "port": 8002,
                    "health": {
                        "path": "/health",
                        "interval": 10
                    }
                }
            ]
        },
        {
            "host": "*.example.com",
            "backends": [
                {
                    "protocol": "http",
                    "host": "127.0.0.1",
                    "port": 8003,
                    "health": {
                        "path": "/health",
                        "interval": 10
                    }
                }
            ]
        }
    ]
}